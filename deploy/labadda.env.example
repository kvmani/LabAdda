# Copy to ~/.config/labadda/<instance>.env and fill in site values. Never commit real values.
LABADDA_ENV=staging
LABADDA_INSTANCE=staging
LABADDA_PORT=8102
LABADDA_BASE_PATH=/labadda-staging
LABADDA_DATABASE_URL=postgresql+psycopg://labadda_staging:CHANGE_ME@localhost:5432/labadda_staging
LABADDA_COOKIE_NAME=labadda_staging
LABADDA_COOKIE_SECURE=true
LABADDA_TRUSTED_ORIGINS=https://labadda.intranet.example
LABADDA_ASSET_DIR=/srv/labadda/staging/assets
LABADDA_FRONTEND_DIST=/home/labadda/labadda/staging/current/frontend/dist
LABADDA_TIMEZONE=UTC
# Directory where scheduled backups write backup-status.json (operator-writable, runtime-readable).
LABADDA_STATUS_DIR=/srv/labadda/staging/status
LABADDA_SESSION_IDLE_MINUTES=120
LABADDA_SESSION_ABSOLUTE_HOURS=12
LABADDA_BOARD_COMPACT_THRESHOLD=2000
LABADDA_BOARD_KEEP_REVISIONS=500
LABADDA_PANEL_IDLE_SECONDS=300
LABADDA_PANEL_ABSOLUTE_MINUTES=60
LABADDA_PANEL_PAIRING_SECONDS=120
# The part after the at sign in staff e-mail addresses (username@domain), used by the Excel staff import.
LABADDA_EMAIL_DOMAIN=domain.in
# Longest a bulk staff change or import review may run (and hold the admin change lock).
LABADDA_BULK_CHANGE_SECONDS=60
# Limits on what each person may upload and create. These are the shipped defaults.
LABADDA_MAX_ATTACHMENTS=5
LABADDA_MAX_ATTACHMENT_BYTES=20971520
LABADDA_USER_QUOTA_BYTES=524288000
LABADDA_MAX_GROUPS_PER_USER=20
LABADDA_MAX_GROUP_MEMBERS=200
# How often due reminders are looked for, and whether this process runs the background scheduler.
LABADDA_REMINDER_INTERVAL_SECONDS=30
LABADDA_RUN_SCHEDULER=true
# Sign-in/activation/pairing attempts per client address per window. Raise only temporarily for a
# supervised load rehearsal, then restore.
LABADDA_LOGIN_ATTEMPTS_PER_WINDOW=10
LABADDA_LOGIN_WINDOW_SECONDS=300
# Usage metrics (AD-08): metadata only. Closed minutes are written in one batch per interval;
# minute, hour and day samples and per-person activity days are deleted after these periods.
LABADDA_METRICS_FLUSH_SECONDS=60
LABADDA_METRICS_MINUTE_RETENTION_HOURS=48
LABADDA_METRICS_HOUR_RETENTION_DAYS=35
LABADDA_METRICS_DAY_RETENTION_DAYS=730
LABADDA_ACTIVITY_RETENTION_DAYS=730
# System health (AD-07). How often the server measures itself, and when an item changes colour.
# These are the shipped defaults; change one only on the advice of the administrator guide.
# A result older than HEALTH_STALE_SECONDS is shown as stale, never as healthy.
LABADDA_HEALTH_SAMPLE_SECONDS=15
LABADDA_HEALTH_STALE_SECONDS=60
# Database: answers slower than this, or more of the connection limit in use, are degraded.
LABADDA_HEALTH_DB_SLOW_MS=250
LABADDA_HEALTH_DB_CONNECTIONS_PERCENT=80
# File storage: free space (bytes) and free file slots (percent) kept in reserve. Degraded from
# reserve + 20 %, unavailable below the reserve. 5368709120 bytes is 5 GiB.
LABADDA_HEALTH_DISK_RESERVE_BYTES=5368709120
LABADDA_HEALTH_INODE_RESERVE_PERCENT=5
# Live connections: queued live messages above this are degraded, above five times it unavailable.
LABADDA_HEALTH_QUEUE_BACKLOG=1000
# Background jobs: seconds without a finished scheduler pass, and failed runs in the last hour.
LABADDA_HEALTH_JOB_STALL_DEGRADED_SECONDS=120
LABADDA_HEALTH_JOB_STALL_UNAVAILABLE_SECONDS=600
LABADDA_HEALTH_JOB_FAILURES_PER_HOUR=3
# Response time and sign-in: p95 milliseconds, server-error percent, failed sign-in percent.
LABADDA_HEALTH_RESPONSE_P95_MS=1000
LABADDA_HEALTH_ERROR_RATE_PERCENT=2
LABADDA_HEALTH_SIGNIN_FAILURE_PERCENT=50
# Backups: hours since the latest report. Needs LABADDA_STATUS_DIR; without it backups are unknown.
LABADDA_HEALTH_BACKUP_FRESH_HOURS=26
LABADDA_HEALTH_BACKUP_STALE_HOURS=50
# Certificate: days left. Read from certificate-status.json in LABADDA_STATUS_DIR; not provided
# means not supported. A report older than CERTIFICATE_FRESH_HOURS is stale.
LABADDA_HEALTH_CERTIFICATE_DEGRADED_DAYS=30
LABADDA_HEALTH_CERTIFICATE_UNAVAILABLE_DAYS=7
LABADDA_HEALTH_CERTIFICATE_FRESH_HOURS=72
# Server: process memory (MB), host load per processor in tenths (20 is 2.0), host memory percent.
LABADDA_HEALTH_PROCESS_MEMORY_MB=1024
LABADDA_HEALTH_LOAD_PER_CPU_X10=20
LABADDA_HEALTH_HOST_MEMORY_PERCENT=90
# Feedback e-mail. People press Feedback in the app; every message is also e-mailed to this
# address through YOUR intranet mail relay. This is the only connection the server makes to
# another machine, and only to the host named here. Leave LABADDA_FEEDBACK_EMAIL blank to keep
# feedback in the administrator console only.
LABADDA_FEEDBACK_EMAIL=
LABADDA_SMTP_HOST=
LABADDA_SMTP_PORT=25
LABADDA_SMTP_STARTTLS=false
LABADDA_SMTP_USER=
# Prefer a file readable only by the service account over a password in this file.
LABADDA_SMTP_PASSWORD=
LABADDA_SMTP_PASSWORD_FILE=
LABADDA_SMTP_FROM=
