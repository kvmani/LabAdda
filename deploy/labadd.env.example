# Copy to ~/.config/labadd/<instance>.env and fill in site values. Never commit real values.
LABADD_ENV=staging
LABADD_INSTANCE=staging
LABADD_PORT=8102
LABADD_BASE_PATH=/labadd-staging
LABADD_DATABASE_URL=postgresql+psycopg://labadd_staging:CHANGE_ME@localhost:5432/labadd_staging
LABADD_COOKIE_NAME=labadd_staging
LABADD_COOKIE_SECURE=true
LABADD_TRUSTED_ORIGINS=https://labadd.intranet.example
LABADD_ASSET_DIR=/srv/labadd/staging/assets
LABADD_FRONTEND_DIST=/home/labadd/labadd/staging/current/frontend/dist
LABADD_TIMEZONE=UTC
LABADD_SESSION_IDLE_MINUTES=120
LABADD_SESSION_ABSOLUTE_HOURS=12
