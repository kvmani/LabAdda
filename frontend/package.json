{
  "name": "labadda-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"../e2e/*.mjs\" \"*.{js,ts}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"../e2e/*.mjs\" \"*.{js,ts}\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
