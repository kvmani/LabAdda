{
  "name": "labadda-frontend",
  "private": true,
  "version": "0.0.1-beta",
  "type": "module",
  "scripts": {
    "help": "node scripts/build-help.mjs",
    "dev": "npm run --silent help && vite",
    "build": "npm run --silent help && tsc -b && vite build",
    "typecheck": "npm run --silent help && tsc -b",
    "test": "vitest run",
    "lint": "npm run --silent help && eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"../e2e/*.mjs\" \"*.{js,ts}\" \"scripts/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"../e2e/*.mjs\" \"*.{js,ts}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "marked": "18.1.1",
    "prettier": "3.9.10",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
